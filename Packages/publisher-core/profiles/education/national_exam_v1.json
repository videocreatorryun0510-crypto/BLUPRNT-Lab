  "visual_priority": [
    {"visual_type": "diagram.reaction", "rank": 1, "is_required": true},
    {"visual_type": "table.comparison", "rank": 2, "is_required": true},
    {"visual_type": "diagram.flowchart", "rank": 3, "is_required": false},
    {"visual_type": "diagram.organ_distribution", "rank": 4, "is_required": false}
