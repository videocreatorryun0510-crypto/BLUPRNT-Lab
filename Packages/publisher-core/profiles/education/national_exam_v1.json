    {"step_id": "learning.errors", "target_kind": "education_block", "target_key": "education.common_errors", "order": 11, "is_required": false},
    {"step_id": "learning.memory", "target_kind": "education_block", "target_key": "education.memory_aid", "order": 12, "is_required": false},
    {"step_id": "learning.history", "target_kind": "education_block", "target_key": "education.exam_history", "order": 13, "is_required": true},
    {"step_id": "learning.ranking", "target_kind": "education_block", "target_key": "education.priority_claim_ranking", "order": 14, "is_required": true},
    {"step_id": "learning.flowchart", "target_kind": "visual_type", "target_key": "diagram.flowchart", "order": 15, "is_required": false},
    {"step_id": "learning.organ", "target_kind": "visual_type", "target_key": "diagram.organ_distribution", "order": 16, "is_required": false}
