      "max_items": 5,
      "requires_generation": false
    },
    {
      "block_id": "education.memory_aid",
      "block_type": "memory_aid",
      "input_sources": ["knowledge_claims", "publisher_generated"],
      "content_roles": ["role.definition", "role.measurement_method", "role.measurement_principle"],
      "exam_fields": [],
      "order": 12,
      "is_required": false,
      "max_items": 3,
      "requires_generation": true
    },
    {
      "block_id": "education.exam_history",
      "block_type": "exam_history",
      "input_sources": ["exam_metadata"],
      "content_roles": [],
      "exam_fields": ["history", "frequency"],
