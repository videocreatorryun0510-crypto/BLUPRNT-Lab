    {"step_id": "learning.comparison", "target_kind": "content_role", "target_key": "role.comparison", "order": 6, "is_required": true},
    {"step_id": "learning.method", "target_kind": "content_role", "target_key": "role.measurement_method", "order": 7, "is_required": true},
    {"step_id": "learning.principle", "target_kind": "content_role", "target_key": "role.measurement_principle", "order": 8, "is_required": true},
    {"step_id": "learning.cautions", "target_kind": "content_role", "target_key": "role.cautions", "order": 9, "is_required": false},
