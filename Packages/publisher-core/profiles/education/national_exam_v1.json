      {"band_id": "exam_priority.highest", "minimum_score": 80, "emphasis_level": 5, "label": "最重要"},
      {"band_id": "exam_priority.frequent", "minimum_score": 60, "emphasis_level": 4, "label": "頻出"},
      {"band_id": "exam_priority.important", "minimum_score": 40, "emphasis_level": 3, "label": "重要"},
      {"band_id": "exam_priority.supplementary", "minimum_score": 0, "emphasis_level": 2, "label": "補足"}
    ]
