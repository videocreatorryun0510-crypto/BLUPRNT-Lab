# Knowledge generation (optional when KNOWLEDGE_PROVIDER=fixture)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
KNOWLEDGE_PROVIDER=fixture

# Phase 5.18 Gemini Sandbox
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_DEBUG_PROMPT=false

# Optional model-specific cost settings. Keep blank when not reviewed.
GEMINI_INPUT_COST_PER_MILLION_TOKENS=
GEMINI_OUTPUT_COST_PER_MILLION_TOKENS=

# Phase 5.26 Gemini Grounded Evidence Search
# GEMINI_API_KEY is shared with the existing Gemini Sandbox secret.
GEMINI_SEARCH_MODEL=gemini-3.6-flash
GEMINI_SEARCH_TIMEOUT_SECONDS=30
GEMINI_SEARCH_MAX_QUERIES=4
GEMINI_SEARCH_MAX_SOURCES=50

# Phase 5.27 PubMed E-utilities Formal Evidence Provider
# NCBI_API_KEY is optional. Without it, the internal limiter stays below 3 req/s.
NCBI_API_KEY=
NCBI_TOOL=bluprnt_lab_medical_os
NCBI_EMAIL=
NCBI_EUTILITIES_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_TIMEOUT_SECONDS=20
NCBI_MAX_RECORDS=20

# Phase 5.28 Evidence-grounded Claim Builder
# GEMINI_API_KEY is shared, but Claim generation has its own exchangeable settings.
GEMINI_CLAIM_MODEL=gemini-3.6-flash
GEMINI_CLAIM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_CLAIM_TIMEOUT_SECONDS=30
GEMINI_CLAIM_MAX_OUTPUT_TOKENS=4096
CLAIM_GENERATION_MAX_CANDIDATES=10
