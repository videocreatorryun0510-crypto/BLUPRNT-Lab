# OpenAI APIキーはこのファイルへ直接書かず、コピーした .env または環境変数へ設定します。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
KNOWLEDGE_PROVIDER=openai

# 通常は変更不要です。台帳を別の場所へ保存する場合だけ絶対パスを指定します。
# KNOWLEDGE_REGISTRY_PATH=/absolute/path/to/knowledge_registry.sqlite3
# KNOWLEDGE_REGISTRY_BACKUP_DIR=/absolute/path/to/registry-backups

# Source BundleのProfileと出力先を変更する場合だけ指定します。
# SOURCE_BUNDLE_PROFILE_DIR=/absolute/path/to/source-bundle-profiles
# SOURCE_BUNDLE_OUTPUT_DIR=/absolute/path/to/source_bundle
# SOURCE_BUNDLE_AUDIT_LOG_PATH=/absolute/path/to/approval_gate.jsonl
