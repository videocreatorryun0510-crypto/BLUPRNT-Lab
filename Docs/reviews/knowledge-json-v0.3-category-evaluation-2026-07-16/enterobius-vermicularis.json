  "term": {
    "canonical_name": "蟯虫",
    "english_name": "Enterobius vermicularis",
    "aliases": [
      "蟯虫症の病原体",
      "pinworm",
      "seatworm"
    ]
  },
  "classification": {
    "term_type": "parasite",
    "primary_exam_domain": "microbiology",
