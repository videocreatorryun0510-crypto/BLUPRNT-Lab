  "core_facts": {
    "definitions": [
      {
        "claim_id": "clm_1b5cb18674afbc10",
        "statement": "HbA1cは、ヘモグロビンAのβ鎖N末端バリンがグルコースにより非酵素的に糖化された分画である。"
      },
      {
        "claim_id": "clm_eed3c3b9f758158a",
        "statement": "HbA1cは、赤血球寿命に相当する期間の平均的な血糖状態を反映する指標である。"
      }
    ],
    "mechanisms": [
      {
        "claim_id": "clm_d15b6b1efdc147ac",
        "statement": "HbA1cは、グルコースとヘモグロビンのアミノ基との非酵素的反応に続くアマドリ転位によって生成する。"
      },
      {
        "claim_id": "clm_11d15dd1f1d5fa08",
        "statement": "HbA1cの値は、血糖値だけでなく赤血球の寿命および赤血球動態の影響を受ける。"
      }
    ],
    "characteristics": [
      {
        "claim_id": "clm_6203253464c1d9c5",
        "statement": "HbA1cは通常、全ヘモグロビンに対するHbA1cの割合として報告される。"
      },
      {
        "claim_id": "clm_1a17ffafe255f893",
        "statement": "HbA1cの標準化には国際臨床化学連合（IFCC）の参照測定系が用いられる。"
      }
    ]
  },
  "category_content": {
