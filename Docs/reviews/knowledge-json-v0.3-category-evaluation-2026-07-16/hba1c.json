    "canonical_name": "ヘモグロビンA1c",
    "english_name": "Hemoglobin A1c",
    "aliases": [
      "HbA1c",
      "糖化ヘモグロビンA1c",
      "グリコヘモグロビンA1c"
    ]
  },
  "classification": {
    "term_type": "test_item",
