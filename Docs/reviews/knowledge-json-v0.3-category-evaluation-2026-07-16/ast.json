  "term": {
    "canonical_name": "アスパラギン酸アミノトランスフェラーゼ",
    "english_name": "Aspartate aminotransferase",
    "aliases": [
      "AST",
      "GOT",
      "グルタミン酸オキサロ酢酸トランスアミナーゼ"
    ]
  },
  "classification": {
    "term_type": "test_item",
    "primary_exam_domain": "clinical_chemistry",
    "related_exam_domains": []
  },
  "core_facts": {
    "definitions": [
      {
        "claim_id": "clm_fdfe7540abbdf7ad",
        "statement": "ASTは、アスパラギン酸とα-ケトグルタル酸のアミノ基転移を触媒するアミノトランスフェラーゼである。"
      },
      {
        "claim_id": "clm_0f1fd1cd1099b548",
        "statement": "ASTは肝臓、心筋、骨格筋、赤血球などに分布する。"
      }
    ],
    "mechanisms": [
      {
        "claim_id": "clm_8a70fde843691e69",
        "statement": "組織細胞の障害により細胞内ASTが血中へ逸脱し、血清AST活性が上昇する。"
      },
      {
        "claim_id": "clm_fc562319aabb0d69",
        "statement": "AST反応には補酵素としてピリドキサールリン酸が関与する。"
      }
    ],
    "characteristics": [
      {
        "claim_id": "clm_aefa758e9a74ec61",
        "statement": "ASTには細胞質型とミトコンドリア型のアイソザイムが存在する。"
      },
      {
        "claim_id": "clm_224cb4b71ad0f13f",
        "statement": "ASTはALTと比べて肝臓以外の組織にも広く分布するため、肝細胞障害に対する臓器特異性は低い。"
      }
    ]
  },
