  "term": {
    "canonical_name": "細菌細胞壁",
    "english_name": "Bacterial cell wall",
    "aliases": [
      "細菌の細胞壁"
    ]
  },
  "classification": {
    "term_type": "biological_structure",
    "primary_exam_domain": "microbiology",
    "related_exam_domains": []
  },
  "core_facts": {
    "definitions": [
      {
        "claim_id": "clm_bwall_definition",
        "assertion": "細菌細胞壁は、細菌の細胞質膜の外側で細胞を包み、ペプチドグリカンを主要な構造要素とする生体構造である。"
      }
    ]
  },
  "category_content": {
    "template_id": "biological_structure_v1.0",
    "biological_structure": {
      "overview": [
        {
          "claim_id": "clm_bwall_overview",
          "assertion": "Gram陽性菌とGram陰性菌ではペプチドグリカン層の厚さや外膜の有無が異なり、この細胞表層構造の差がGram染色における染色性の違いに関係する。"
        }
      ],
      "main_functions": [
        {
          "claim_id": "clm_bwall_function",
          "function_name": "形態維持と機械的保護",
          "assertion": "細菌細胞壁のペプチドグリカンは細菌の特徴的な形を保ち、細胞へ機械的な保護を与える。"
        }
      ],
      "main_components": [
        {
          "claim_id": "clm_bwall_component",
          "component_name": "ペプチドグリカン",
          "assertion": "Gram陽性菌とGram陰性菌の細胞壁はいずれもペプチドグリカンを主要な構造要素として持つが、その層の厚さは異なる。"
        }
      ],
      "organisms_present": [
        {
          "claim_id": "clm_bwall_organisms",
          "organism_name": "多くの細菌",
          "assertion": "細胞壁は多くの細菌に存在するが、Mycoplasma属など細胞壁ペプチドグリカンを持たない細菌もある。"
        }
      ]
    }
  },
