          "use_case": "Gram染色の対比染色",
          "assertion": "サフラニン対比染色液は、脱色されたGram陰性菌を赤色から赤桃色に可視化するために用いる。"
        }
      ],
      "targets": [
        {
          "claim_id": "clm_reagent_safranin_target",
          "target_name": "脱色後の細菌塗抹標本",
          "target_kind": "decolorized_smear_specimen",
          "assertion": "サフラニン対比染色液は脱色工程後の細菌塗抹標本へ適用する。"
        }
      ],
      "usage_steps": [
        {
          "claim_id": "clm_reagent_safranin_usage",
          "usage_phase": "counterstaining",
          "application": "脱色と洗浄後の塗抹標本を対比染色液で覆い、規定時間作用させた後に洗浄する。",
          "conditions": "試薬の種類、作用時間、洗浄条件は製品添付文書または施設の標準作業書に従う。",
          "assertion": "Gram染色では脱色後の対比染色工程でサフラニン対比染色液を使用する。"
        }
      ],
      "cautions": [
        {
          "claim_id": "clm_reagent_safranin_caution",
          "assertion": "対比染色試薬にはサフラニン以外を採用する手順もあるため、使用試薬と判定基準を施設の標準作業書で確認する。"
