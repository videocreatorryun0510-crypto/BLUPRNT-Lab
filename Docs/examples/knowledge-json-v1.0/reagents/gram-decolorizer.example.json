  "core_facts": {
    "definitions": [
      {
        "claim_id": "clm_reagent_decolorizer_definition",
        "assertion": "グラム染色用脱色液は、アルコール、アセトン、またはその混合液を用いて色素・ヨウ素複合体の保持差を生じさせる試薬である。"
      }
    ]
  },
  "category_content": {
    "template_id": "reagent_v1.0",
    "reagent": {
      "reagent_kind": "decolorizer",
      "purposes": [
        {
          "claim_id": "clm_reagent_decolorizer_purpose",
          "use_case": "Gram染色の脱色",
          "assertion": "脱色液はGram陽性菌とGram陰性菌における色素・ヨウ素複合体の保持差を明らかにするために用いる。"
        }
      ],
      "targets": [
        {
          "claim_id": "clm_reagent_decolorizer_target",
          "target_name": "媒染後の細菌塗抹標本",
          "target_kind": "mordanted_smear_specimen",
          "assertion": "脱色液はクリスタルバイオレットとヨウ素液による処理後の塗抹標本へ適用する。"
        }
      ],
      "usage_steps": [
        {
          "claim_id": "clm_reagent_decolorizer_usage",
          "usage_phase": "decolorization",
          "application": "媒染後の塗抹標本へ脱色液を作用させ、規定された終点または時間で直ちに洗浄する。",
          "conditions": "脱色液の組成、作用時間、終点は製品添付文書または施設の標準作業書に従う。",
          "assertion": "Gram染色では媒染後、対比染色前の脱色工程で脱色液を使用する。"
        }
      ],
      "cautions": [
        {
          "claim_id": "clm_reagent_decolorizer_caution",
          "assertion": "過脱色と脱色不足はいずれもGram反応の誤判定につながるため、作用時間と終点を管理し、安全データシートに従って取り扱う。"
        }
      ],
      "storage_conditions": [
        {
          "claim_id": "clm_reagent_decolorizer_storage",
          "temperature": null,
          "conditions": "密栓、温度、火気管理、有効期限は製品の安全データシート、添付文書および施設手順に従う。",
          "assertion": "グラム染色用脱色液は組成と製品ごとに指定された保管・安全条件で管理する。"
        }
      ]
    }
  },
