  "term": {
    "canonical_name": "フェリチン",
    "english_name": "Ferritin",
    "aliases": [
      "血清フェリチン",
      "FER"
    ]
  },
  "classification": {
    "term_type": "laboratory_test_item",
    "primary_exam_domain": "clinical_chemistry",
    "related_exam_domains": [
      "hematology",
      "immunology"
    ]
  },
  "core_facts": {
    "definitions": [
      {
        "claim_id": "clm_ferritin_definition",
        "assertion": "フェリチンは、アポフェリチンに三価鉄が結合して形成される水溶性の鉄貯蔵タンパク質である。"
      }
    ]
  },
  "category_content": {
    "template_id": "laboratory_test_item_v1.0",
    "laboratory_test_item": {
      "overview": [
        {
          "claim_id": "clm_ferritin_overview",
          "assertion": "血清または血漿中のフェリチンは体内の貯蔵鉄を評価する指標であるが、炎症などでも上昇するため臨床背景と併せて解釈する。"
        }
      ],
      "measured_targets": [
        {
          "claim_id": "clm_ferritin_target",
          "analyte_name": "フェリチン濃度",
          "typical_specimens": [
            "血清",
            "血漿"
          ],
          "assertion": "代表的なフェリチン検査は、血清または血漿中のフェリチン濃度を測定する。"
        }
      ],
      "clinical_significance": [
        {
          "claim_id": "clm_ferritin_significance_iron_store",
          "significance_name": "貯蔵鉄の評価",
          "assertion": "血清フェリチンは体内の貯蔵鉄量を反映し、鉄欠乏の評価に用いられる。"
        },
        {
          "claim_id": "clm_ferritin_significance_inflammation",
          "significance_name": "炎症を考慮した解釈",
          "assertion": "フェリチンは炎症に伴って上昇し得るため、鉄代謝を評価する際は炎症の有無を考慮する。"
        }
      ],
      "high_conditions": [
        {
          "claim_id": "clm_ferritin_high_iron_overload",
          "condition_name": "鉄過剰",
          "assertion": "輸血後鉄過剰など、体内の鉄が過剰となる病態では血清フェリチンが高値となり得る。"
        },
        {
          "claim_id": "clm_ferritin_high_inflammation",
          "condition_name": "炎症",
          "assertion": "炎症反応に伴って血清フェリチンは高値となり得る。"
        },
        {
          "claim_id": "clm_ferritin_high_macrophage_activation",
          "condition_name": "マクロファージ活性化を伴う病態",
          "assertion": "血球貪食症候群や成人Still病などでは血清フェリチンが著しく上昇することがある。"
        }
      ],
      "low_conditions": [
        {
          "claim_id": "clm_ferritin_low_iron_deficiency",
          "condition_name": "鉄欠乏",
          "assertion": "体内の貯蔵鉄が減少する鉄欠乏では血清フェリチンが低値となる。"
        }
      ],
      "measurement_methods": [
        {
          "claim_id": "clm_ferritin_method_ltia",
          "method_name": "ラテックス凝集比濁法",
          "method_family": "免疫測定法",
          "assertion": "ラテックス凝集比濁法はフェリチン濃度の定量に用いられる代表的な測定法の一つである。"
        },
        {
          "claim_id": "clm_ferritin_method_cleia",
          "method_name": "化学発光酵素免疫測定法",
          "method_family": "免疫測定法",
          "assertion": "化学発光酵素免疫測定法は血清または血漿中フェリチンの定量に用いられる代表的な測定法の一つである。"
        }
      ]
    }
  },
